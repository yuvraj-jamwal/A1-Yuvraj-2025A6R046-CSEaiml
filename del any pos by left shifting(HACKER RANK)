#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
int n,pos;
    scanf("%d",&n);
    int num[n];
    for(int i=0;i<n;i++){
        scanf("%d",&num[i]);
    }
    
    scanf("%d",&pos);
    pos--;
    if(pos<0 || pos>n){
        printf("Invalid position");
    }else{
    for(int i=pos;i<n-1;i++){
          num[i]=num[i+1];
    }n--;
     for(int i=0;i<n;i++)
         printf("%d ",num[i]);}

    return 0;
}
